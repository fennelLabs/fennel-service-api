# Fixed Fee Configuration for Fennel Service API
# Use these environment variables to set fixed transaction fees
# This bypasses the problematic blockchain fee calculation

# Fixed fee for signal transactions (in smallest FNL unit: 1 FNL = 1000000000000)
# Default: 1000000000000 = 1 FNL
FIXED_SIGNAL_FEE=1000000000000

# Fixed fee for token transfers (in smallest FNL unit)  
# Default: 500000000000 = 0.5 FNL
FIXED_TRANSFER_FEE=500000000000

# Example fee values:
# 100000000000 = 0.1 FNL (very low fee)
# 500000000000 = 0.5 FNL (low fee) 
# 1000000000000 = 1 FNL (standard fee)
# 2000000000000 = 2 FNL (high fee)

# To use these values, source this file or add these to your deployment environment:
# export FIXED_SIGNAL_FEE=1000000000000
# export FIXED_TRANSFER_FEE=500000000000
